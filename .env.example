# ======================
# Application Settings
# ======================

# Backend base URL (used by frontend to call APIs in production)
BACKEND_URL=http://localhost:3000

# Frontend base URL (used in CI/CD / reverse proxies)
FRONTEND_URL=http://localhost:3000

# Node environment flag
NODE_ENV=development   # change to "production" in prod

# ======================
# Email (for notifications / support emails if needed at root level)
SUPPORT_EMAIL=support@example.com
