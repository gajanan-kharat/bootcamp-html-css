# ======================
# Email Configuration
# ======================
EMAIL_USER=your_email@gmail.com      # Gmail address (with App Password enabled)
EMAIL_PASS=your_google_app_password  # 16-char app password, no spaces
EMAIL_SUB=Payment Successful         # Default email subject for receipts

# ======================
# Server Configuration
# ======================
PORT=3000

# ======================
# Database (Optional)
# ======================
MONGO_URI=mongodb://127.0.0.1:27017/Database  # Only if you plan to use MongoDB

# ======================
# Firestore
# ======================
DB_COLLECTION_NAME=bootcamp   # Firestore collection for bootcamp users

# ======================
# Bootcamp Details
# ======================
FEE_BOOT_CAMP=99/-                                 # Fee
EVENT_NAME=3 days Bootcamp - Make your own website # Name of event
EVENT_DATE=06/09/2024 TO 08/09/2024               # Dates
EVENT_LOCATION=Online                             # Location
ZOOM_LINK=https://example.com/zoom                # Zoom/Meet link

# ======================
# Razorpay Keys (Test/Prod)
# ======================
KEY_ID=rzp_test_yourkeyid
KEY_SECRET=yourkeysecret
